<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="LubricentroControl_2026.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Lubricentro Control</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

</head>
<%-- Los separadores del formato regional del servidor, para que Lubricentro.js ordene bien
     las columnas con importes (N2 sale "1.234,50" o "1,234.50" según la cultura).
     con-menu / sin-menu: con usuario logueado la página lleva la barra lateral. --%>
<body class="<%: ClaseCuerpo %>"
      data-separador-decimal="<%: System.Globalization.CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator %>"
      data-separador-miles="<%: System.Globalization.CultureInfo.CurrentCulture.NumberFormat.NumberGroupSeparator %>">
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>

        <%-- Tablas ordenables/filtrables, selectores con búsqueda y modales. Va acá, después de los
             scripts de MS Ajax, porque se engancha a Sys.Application para volver a iniciarse después
             de cada postback parcial de un UpdatePanel. --%>
        <asp:PlaceHolder runat="server">
            <%: Scripts.Render("~/Scripts/Lubricentro.js") %>
        </asp:PlaceHolder>

        <%-- Filtro, orden y página de cada tabla: Lubricentro.js lo guarda acá para que sobreviva
             a los postbacks (un GET nuevo lo trae vacío y las tablas arrancan de cero). --%>
        <asp:HiddenField ID="hdnEstadoTablas" runat="server" ClientIDMode="Static" />

        <asp:PlaceHolder ID="phNavegacion" runat="server">
            <%-- Barra superior: solo en pantallas angostas, donde la barra lateral queda escondida
                 y se abre con este botón. --%>
            <header class="barra-superior">
                <button type="button" class="barra-superior-boton" data-bs-toggle="offcanvas"
                    data-bs-target="#barraLateral" aria-controls="barraLateral" aria-label="Abrir el menú">
                    <span></span><span></span><span></span>
                </button>
                <a href="<%: ResolveUrl("~/Default") %>" class="marca marca-chica">
                    <span class="marca-isotipo" aria-hidden="true"><%= Isotipo %></span>
                    <span class="marca-texto">Lubricentro <strong>Control</strong></span>
                </a>
            </header>

            <%-- Barra lateral fija a la izquierda. En pantallas angostas el panel pasa a ser un
                 offcanvas de Bootstrap (offcanvas-lg) que se abre desde la barra superior. --%>
            <aside class="barra-lateral">
                <div id="barraLateral" class="barra-lateral-panel offcanvas-lg offcanvas-start" tabindex="-1"
                    aria-label="Menú principal">
                    <div class="barra-lateral-encabezado">
                        <a href="<%: ResolveUrl("~/Default") %>" class="marca">
                            <span class="marca-isotipo" aria-hidden="true"><%= Isotipo %></span>
                            <span class="marca-texto">Lubricentro <strong>Control</strong></span>
                        </a>
                        <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas"
                            data-bs-target="#barraLateral" aria-label="Cerrar el menú"></button>
                    </div>

                    <nav class="menu-lateral" aria-label="Secciones">
                        <asp:Literal ID="litMenu" runat="server" />
                    </nav>
                    <%-- Abre los grupos que el usuario dejó abiertos, antes de que se vea el menú. --%>
                    <script>if (window.Lubricentro) Lubricentro.restaurarMenu();</script>

                    <div class="barra-lateral-usuario">
                        <div class="usuario-datos">
                            <span class="usuario-avatar" aria-hidden="true"><asp:Literal ID="litIniciales" runat="server" /></span>
                            <span class="usuario-texto">
                                <span class="usuario-nombre"><asp:Literal ID="litUsuario" runat="server" /></span>
                                <span class="usuario-rol"><asp:Literal ID="litRol" runat="server" /></span>
                            </span>
                        </div>
                        <div class="usuario-acciones">
                            <a runat="server" href="~/CambiarClave">Cambiar contraseña</a>
                            <asp:LinkButton ID="lnkCerrarSesion" runat="server"
                                OnClick="lnkCerrarSesion_Click" CausesValidation="false">Cerrar sesión</asp:LinkButton>
                        </div>
                    </div>
                </div>
            </aside>
        </asp:PlaceHolder>

        <div class="area-principal">
            <main class="contenido-principal">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </main>
            <footer class="pie-pagina">
                &copy; <%: DateTime.Now.Year %> · Lubricentro Control · Programación Avanzada 2026
            </footer>
        </div>
    </form>
    <asp:PlaceHolder runat="server">
        <%--bundle.js incluye Popper, necesario para los desplegables--%>
        <%: Scripts.Render("~/Scripts/bootstrap.bundle.js") %>
    </asp:PlaceHolder>
</body>
</html>
